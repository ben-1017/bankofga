      "item": [
        {
          "name": "Open account — 201",
          "request": {
            "method": "POST",
            "url": "{{account_host}}/api/accounts",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"productId\": \"{{product_id}}\",\n  \"initialDeposit\": 500.00\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('has account number', () => pm.expect(b.accountNumber).to.match(/^BOG/));",
                  "pm.test('balance matches deposit', () => pm.expect(b.balance).to.eql(500.00));",
                  "pm.test('status is ACTIVE', () => pm.expect(b.status).to.eql('ACTIVE'));",
                  "pm.collectionVariables.set('account_id', b.id);"
