        {
          "name": "Update customer — 200",
          "request": {
            "method": "PUT",
            "url": "{{customer_host}}/api/customers/{{customer_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Updated\",\n  \"phone\": \"555-9999\"\n}"
            }
