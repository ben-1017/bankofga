{
  "info": {
    "name": "Bank of Georgia — Sprint 1",
    "description": "API smoke + happy/error paths for all services. Start docker compose and each service via mvn spring-boot:run before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "customer_host",     "value": "http://localhost:8181" },
    { "key": "product_host",      "value": "http://localhost:8082" },
    { "key": "account_host",      "value": "http://localhost:8083" },
    { "key": "transaction_host",  "value": "http://localhost:8084" },
    { "key": "notification_host", "value": "http://localhost:8085" },
    { "key": "customer_id",       "value": "" },
    { "key": "product_id",        "value": "" },
    { "key": "account_id",        "value": "" },
    { "key": "transaction_id",    "value": "" },
    { "key": "notification_id",   "value": "" }
